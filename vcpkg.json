{
  "name": "litecap",
  "version-string": "0.1.0",
  "description": "Ressourcenschonendes Screen-Capture-Tool für Windows",
  "builtin-baseline": "469a0504e4a6ebf6173d1c0f51a7fa34c382fd43",
  "dependencies": [
    "nlohmann-json",
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swresample",
        "swscale",
        "nvcodec",
        "amf",
        "qsv",
        "gpl",
        "x264",
        "svt-av1"
      ]
    }
  ],
  "$ffnvcodec": "NVENC-API 12.1 läuft ab NVIDIA-Treiber 531.61 (auch GTX 900/10, deren letzter Treiber die 580er-Reihe ist). 13.x verlangt Treiber 570 bzw. 610+.",
  "overrides": [
    { "name": "ffnvcodec", "version": "12.1.14.0" }
  ]
}
